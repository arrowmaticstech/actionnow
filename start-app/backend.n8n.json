      {
        "parameters": {
          "jsCode": "// 1. Get the current time in GMT+8\nconst now = new Date();\nconst gmt8Offset = 8 * 60 * 60 * 1000; // 8 hours in milliseconds\nconst  refresh_seconds =$input.first().json.refresh_seconds\nconst  from_date=$input.first().json.from_date\n// 2. Parse input data from the previous node\nconst fromDateStr = from_date; \nconst refreshSeconds = parseInt(refresh_seconds, 10) || 3600;\nconst fromDate = new Date(fromDateStr);\n\n// 3. Validation: If current time is before from_date, stop execution\nif (now < fromDate) {\n  return []; // Returning an empty array stops the workflow here if \"Always Output Data\" is off\n}\n\n// 4. Align the intervals properly\n// Find out how many intervals have passed between from_date and now\nconst elapsedMs = now.getTime() - fromDate.getTime();\nconst intervalMs = refreshSeconds * 1000;\n\n// Calculate the number of full intervals passed, then find the very next slot\nconst completedIntervals = Math.floor(elapsedMs / intervalMs);\nlet nextSlotTimeMs = fromDate.getTime() + ((completedIntervals + 1) * intervalMs);\n\n// 5. Generate the next 100 slots\nconst timeslots = [];\nfor (let i = 0; i < 100; i++) {\n  const slotDate = new Date(nextSlotTimeMs + (i * intervalMs));\n  \n  // Convert to local GMT+8 ISO string for clean output display\n  const gmt8Time = new Date(slotDate.getTime() + gmt8Offset);\n  const gmt8String = gmt8Time.toISOString().replace('Z', '+08:00');\n\n  timeslots.push({\n    slot_index: i + 1,\n    timestamp_utc: slotDate.toISOString(),\n    timestamp_gmt8: gmt8String\n  });\n}\n\n// 6. Return the array of timeslots to n8n\nreturn timeslots.map(slot => ({ json: slot }));\n// return null"
        },
