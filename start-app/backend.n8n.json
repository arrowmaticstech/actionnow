          "jsCode": "const item = $input.first().json;\nconst raw =\n  item.body && typeof item.body === 'object' && !Array.isArray(item.body)\n    ? item.body\n    : item;\n\nfunction arr(v) {\n  if (Array.isArray(v)) return v.map((x) => String(x).trim()).filter(Boolean);\n  if (v == null || v === '') return [];\n  return [String(v).trim()].filter(Boolean);\n}\n\nconst toDate = raw.to_date;\n\nreturn [{\n  json: {\n    owner_email: String(raw.owner_email ?? '').trim(),\n    owner_phone_num: String(raw.owner_phone_num ?? '').trim(),\n    monitor_name: String(raw.monitor_name ?? raw.supervision_label ?? 'Untitled').trim(),\n    from_group_ids: arr(raw.from_group_ids),\n    from_contact_jids: arr(raw.from_contact_jids),\n    to_receipient_phone_ids: arr(raw.to_receipient_phone_ids),\n    what_content_keywords: arr(raw.what_content_keywords),\n    what_content_types: arr(raw.what_content_types),\n    from_date: raw.from_date ?? null,\n    to_date: toDate === '' || toDate === undefined ? null : toDate,\n    refresh_seconds: Number(raw.refresh_seconds) || 900,\n  },\n}];"
